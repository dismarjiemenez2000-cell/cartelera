// Este archivo es un listado de cosas que no queremos subir al repositorio de Git (que no queremos que se versionen).
# --- Entorno virtual ---
venv/

# --- Caché de Python ---
__pycache__/
*.py[cod]

# --- Bases de datos locales ---
*.db
*.sqlite3

# --- Archivos subidos por usuarios (carátulas, guía 7) ---
uploads/

# --- Pruebas (fase 6) ---
.pytest_cache/

# --- Secretos locales (si algún día se usa un .env, jamás al repo) ---
.env

# --- Editores / sistema ---
.vscode/
.idea/
Thumbs.db
.DS_Store